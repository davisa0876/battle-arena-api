{
  "/api/pvp/rooms": {
    "post": {
      "tags": ["PvP"],
      "summary": "Create a private PvP lobby and invite by exact handle",
      "description": "Requires trainer level >= 6. Creates a pending invitation. Idempotent via Idempotency-Key header or body idempotency_key. features.pvp remains false; no combat/XP.",
      "security": [{ "sanctum": [] }],
      "parameters": [
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": false,
          "schema": { "type": "string", "maxLength": 120 }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["invitee_handle"],
              "properties": {
                "invitee_handle": { "type": "string", "minLength": 3, "maxLength": 24 },
                "idempotency_key": { "type": "string", "maxLength": 120 }
              }
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Lobby + invitation created",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpCreateRoomResponse" }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "403": { "$ref": "#/components/schemas/PvpError" },
        "409": { "$ref": "#/components/schemas/PvpError" },
        "422": { "$ref": "#/components/responses/ValidationError" },
        "429": { "$ref": "#/components/responses/TooManyRequests" }
      }
    }
  },
  "/api/pvp/online": {
    "get": {
      "tags": ["PvP"],
      "summary": "List online PvP-eligible opponents",
      "description": "Returns trainers currently connected to the realtime gateway, eligible for private PvP (level >= pvp_min_trainer_level), excluding the caller and players already in an open lobby/battle. Presence is authenticated app session + PvP level (any screen) — not limited to the PvP lobby route. Clients should keep a WS open via the global presence keeper. Clicking a row should call POST /api/pvp/rooms with that handle.",
      "security": [{ "sanctum": [] }],
      "responses": {
        "200": {
          "description": "Online opponents",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpOnlineOpponentsResponse" }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "429": { "$ref": "#/components/responses/TooManyRequests" }
      }
    }
  },
  "/api/pvp/invitations": {
    "get": {
      "tags": ["PvP"],
      "summary": "List sent or received private invitations",
      "security": [{ "sanctum": [] }],
      "parameters": [
        {
          "name": "box",
          "in": "query",
          "required": true,
          "schema": { "type": "string", "enum": ["received", "sent"] }
        }
      ],
      "responses": {
        "200": {
          "description": "Invitation list",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpInvitationListResponse" }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "422": { "$ref": "#/components/responses/ValidationError" }
      }
    }
  },
  "/api/pvp/invitations/{invitation}/accept": {
    "post": {
      "tags": ["PvP"],
      "summary": "Accept a pending invitation",
      "security": [{ "sanctum": [] }],
      "parameters": [
        { "name": "invitation", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string" } }
      ],
      "responses": {
        "200": {
          "description": "Ready lobby",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpRoomResponse" }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "403": { "$ref": "#/components/schemas/PvpError" },
        "404": { "$ref": "#/components/schemas/PvpError" },
        "409": { "$ref": "#/components/schemas/PvpError" },
        "429": { "$ref": "#/components/responses/TooManyRequests" }
      }
    }
  },
  "/api/pvp/invitations/{invitation}/decline": {
    "post": {
      "tags": ["PvP"],
      "summary": "Decline a pending invitation",
      "security": [{ "sanctum": [] }],
      "parameters": [
        { "name": "invitation", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string" } }
      ],
      "responses": {
        "200": { "description": "Invitation declined" },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "404": { "$ref": "#/components/schemas/PvpError" },
        "429": { "$ref": "#/components/responses/TooManyRequests" }
      }
    }
  },
  "/api/pvp/invitations/{invitation}/cancel": {
    "post": {
      "tags": ["PvP"],
      "summary": "Cancel a sent pending invitation",
      "security": [{ "sanctum": [] }],
      "parameters": [
        { "name": "invitation", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string" } }
      ],
      "responses": {
        "200": { "description": "Invitation cancelled and lobby closed" },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "404": { "$ref": "#/components/schemas/PvpError" },
        "429": { "$ref": "#/components/responses/TooManyRequests" }
      }
    }
  },
  "/api/pvp/rooms/{room}": {
    "get": {
      "tags": ["PvP"],
      "summary": "Fetch authoritative private lobby state",
      "security": [{ "sanctum": [] }],
      "parameters": [
        { "name": "room", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": {
        "200": {
          "description": "Room state for an active member",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpRoomResponse" }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "404": { "$ref": "#/components/schemas/PvpError" }
      }
    }
  },
  "/api/pvp/rooms/{room}/leave": {
    "post": {
      "tags": ["PvP"],
      "summary": "Leave and close a private lobby (no XP)",
      "security": [{ "sanctum": [] }],
      "parameters": [
        { "name": "room", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string" } }
      ],
      "responses": {
        "200": {
          "description": "Lobby closed",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpRoomResponse" }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "404": { "$ref": "#/components/schemas/PvpError" },
        "429": { "$ref": "#/components/responses/TooManyRequests" }
      }
    }
  },
  "/api/pvp/rooms/{room}/subscription-grants": {
    "post": {
      "tags": ["PvP"],
      "summary": "Issue a one-use WebSocket room subscription grant",
      "description": "Member-only. Redis-backed one-time grant redeemed by Node via GETDEL. Cache-Control: no-store. connection.ready alone is not room authorization.",
      "security": [{ "sanctum": [] }],
      "parameters": [
        { "name": "room", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": {
        "201": {
          "description": "Grant issued",
          "headers": {
            "Cache-Control": {
              "schema": { "type": "string", "example": "no-store" }
            }
          },
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpRoomGrantResponse" }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "404": { "$ref": "#/components/schemas/PvpError" },
        "429": { "$ref": "#/components/responses/TooManyRequests" },
        "503": { "$ref": "#/components/schemas/PvpError" }
      }
    }
  },
  "/api/pvp/rooms/{room}/selection": {
    "put": {
      "tags": ["PvP"],
      "summary": "Select (or change) an owned creature for the private lobby",
      "description": "Member-only. Requires room status ready and matching expected_room_version. Selection can change until locked via ready. features.pvp remains false; no public matchmaking.",
      "security": [{ "sanctum": [] }],
      "parameters": [
        { "name": "room", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": false,
          "schema": { "type": "string", "maxLength": 120 },
          "description": "Preferred idempotency header. Falls back to body `idempotency_key`."
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/PvpSelectCreatureRequest" }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Lobby combat state with my_selection",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpLobbyCombatResponse" }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "403": { "$ref": "#/components/schemas/PvpError" },
        "404": { "$ref": "#/components/schemas/PvpError" },
        "409": {
          "description": "PVP_ROOM_NOT_READY, PVP_SELECTION_LOCKED, PVP_VERSION_CONFLICT, PVP_ALREADY_IN_BATTLE, etc.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpError" }
            }
          }
        },
        "422": {
          "description": "Validation or PVP_CREATURE_NOT_OWNED",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpError" }
            }
          }
        },
        "429": { "$ref": "#/components/responses/TooManyRequests" }
      }
    }
  },
  "/api/pvp/rooms/{room}/ready": {
    "post": {
      "tags": ["PvP"],
      "summary": "Lock creature selection and mark ready",
      "description": "When both members are ready, starts exactly one PvP battle and returns lobby state plus actor-relative battle snapshot. features.pvp remains false; no matchmaking.",
      "security": [{ "sanctum": [] }],
      "parameters": [
        { "name": "room", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": false,
          "schema": { "type": "string", "maxLength": 120 }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/PvpReadyRoomRequest" }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Lobby combat state; includes battle when the match has started",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpLobbyCombatResponse" }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "403": { "$ref": "#/components/schemas/PvpError" },
        "404": { "$ref": "#/components/schemas/PvpError" },
        "409": {
          "description": "PVP_ROOM_NOT_READY, PVP_VERSION_CONFLICT, PVP_ALREADY_IN_BATTLE, etc.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpError" }
            }
          }
        },
        "422": {
          "description": "Validation or PVP_SELECTION_REQUIRED",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpError" }
            }
          }
        },
        "429": { "$ref": "#/components/responses/TooManyRequests" }
      }
    }
  },
  "/api/pvp/battles/{battle}": {
    "get": {
      "tags": ["PvP"],
      "summary": "Get actor-relative PvP battle state",
      "description": "Participant-only. Returns viewer-relative `me` / `opponent` (opponent moves omitted). Clients rehydrate from this after missing WebSocket hints. features.pvp remains false; no matchmaking.",
      "security": [{ "sanctum": [] }],
      "parameters": [
        { "name": "battle", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpBattleResponse" }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "404": {
          "description": "PVP_NOT_FOUND (non-member or missing)",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpError" }
            }
          }
        }
      }
    }
  },
  "/api/pvp/battles/{battle}/events": {
    "get": {
      "tags": ["PvP"],
      "summary": "List PvP battle events after a sequence",
      "description": "Participant-only. Optional `after_sequence` query skips already-seen events (default 0). Cap 200.",
      "security": [{ "sanctum": [] }],
      "parameters": [
        { "name": "battle", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        {
          "name": "after_sequence",
          "in": "query",
          "required": false,
          "schema": { "type": "integer", "minimum": 0, "default": 0 }
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpBattleEventsResponse" }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "404": {
          "description": "PVP_NOT_FOUND",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpError" }
            }
          }
        }
      }
    }
  },
  "/api/pvp/battles/{battle}/attack": {
    "post": {
      "tags": ["PvP"],
      "summary": "Submit a PvP attack (or recover-skip)",
      "description": "Attacker-only while phase is awaiting_attack. Provide exactly one of `move_id`, `basic_strike`, or `recover`. Requires Idempotency-Key and expected_version. On 409 (PVP_WRONG_TURN / PVP_VERSION_CONFLICT / PVP_PHASE_CONFLICT / PVP_ALREADY_FINISHED), rehydrate via GET battle. features.pvp remains false; no matchmaking.",
      "security": [{ "sanctum": [] }],
      "parameters": [
        { "name": "battle", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "schema": { "type": "string", "maxLength": 120 },
          "description": "Required. Falls back to body `idempotency_key` if header omitted."
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/PvpAttackRequest" }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Attack committed; actor-relative battle state",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpBattleResponse" }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "404": { "$ref": "#/components/schemas/PvpError" },
        "409": {
          "description": "PVP_WRONG_TURN, PVP_PHASE_CONFLICT, PVP_VERSION_CONFLICT, PVP_ALREADY_FINISHED, PVP_IDEMPOTENCY_CONFLICT",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpError" }
            }
          }
        },
        "422": {
          "description": "Validation, IDEMPOTENCY_REQUIRED, or PVP_INVALID_ATTACK",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpError" }
            }
          }
        },
        "429": { "$ref": "#/components/responses/TooManyRequests" }
      }
    }
  },
  "/api/pvp/battles/{battle}/forfeit": {
    "post": {
      "tags": ["PvP"],
      "summary": "Explicitly forfeit an active PvP battle",
      "description": "Participant-only. Requires Idempotency-Key and expected_version. Ends the battle with end_reason=forfeit, proposed noncombat XP 0/0, and does not resolve a pending attack as combat. Room leave during active combat remains blocked. features.pvp remains false; no matchmaking.",
      "security": [{ "sanctum": [] }],
      "parameters": [
        { "name": "battle", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "schema": { "type": "string", "maxLength": 120 }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["expected_version"],
              "properties": {
                "expected_version": { "type": "integer", "minimum": 1 },
                "idempotency_key": { "type": "string", "maxLength": 120 }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Battle forfeited; actor-relative battle + rewards",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpActionResponse" }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "404": { "$ref": "#/components/schemas/PvpError" },
        "409": {
          "description": "PVP_VERSION_CONFLICT, PVP_ALREADY_FINISHED, IDEMPOTENCY_CONFLICT",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpError" }
            }
          }
        },
        "422": {
          "description": "Validation, IDEMPOTENCY_REQUIRED, or PVP_FORFEIT_DISABLED",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpError" }
            }
          }
        },
        "429": { "$ref": "#/components/responses/TooManyRequests" }
      }
    }
  },
  "/api/pvp/battles/{battle}/defend": {
    "post": {
      "tags": ["PvP"],
      "summary": "Submit a PvP defense and resolve the exchange",
      "description": "Defender-only while phase is awaiting_defense. Requires Idempotency-Key and expected_version. Resolves damage/PP/stamina server-side; may finish the battle and include rewards. features.pvp remains false; no matchmaking.",
      "security": [{ "sanctum": [] }],
      "parameters": [
        { "name": "battle", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "schema": { "type": "string", "maxLength": 120 },
          "description": "Required. Falls back to body `idempotency_key` if header omitted."
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/PvpDefendRequest" }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Defense resolved; may include rewards when the match finished",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpActionResponse" }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthenticated" },
        "404": { "$ref": "#/components/schemas/PvpError" },
        "409": {
          "description": "PVP_WRONG_TURN, PVP_PHASE_CONFLICT, PVP_VERSION_CONFLICT, PVP_ALREADY_FINISHED, PVP_IDEMPOTENCY_CONFLICT",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpError" }
            }
          }
        },
        "422": {
          "description": "Validation, IDEMPOTENCY_REQUIRED, or PVP_INVALID_DEFENSE",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PvpError" }
            }
          }
        },
        "429": { "$ref": "#/components/responses/TooManyRequests" }
      }
    }
  }
}
