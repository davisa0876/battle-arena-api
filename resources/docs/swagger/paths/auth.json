{
  "/api/register": {
    "post": {
      "tags": [
        "Auth"
      ],
      "summary": "Register a trainer (user + profile + level-1 progress)",
      "description": "Throttled. Without `device_name` from a stateful browser origin a cookie session is started; otherwise `device_name` is required and a token is returned.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "handle",
                "email",
                "password",
                "password_confirmation"
              ],
              "properties": {
                "handle": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 24,
                  "pattern": "^[a-zA-Z0-9_]+$",
                  "description": "Stored lowercase; unique case-insensitively."
                },
                "display_name": {
                  "type": "string",
                  "maxLength": 64,
                  "nullable": true,
                  "description": "Defaults to the handle."
                },
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "password": {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 72,
                  "description": "Must contain letters and numbers."
                },
                "password_confirmation": {
                  "type": "string"
                },
                "device_name": {
                  "type": "string",
                  "maxLength": 120,
                  "description": "Required for non-browser clients."
                }
              }
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Registered",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticatedUserResponse"
              }
            }
          }
        },
        "422": {
          "$ref": "#/components/responses/ValidationError"
        },
        "429": {
          "$ref": "#/components/responses/TooManyRequests"
        }
      }
    }
  },
  "/api/login": {
    "post": {
      "tags": [
        "Auth"
      ],
      "summary": "Log in (session or token)",
      "description": "Throttled per email and IP.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "email",
                "password"
              ],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "password": {
                  "type": "string"
                },
                "device_name": {
                  "type": "string",
                  "maxLength": 120,
                  "description": "Present for mobile clients; returns a bearer token."
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Authenticated",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticatedUserResponse"
              }
            }
          }
        },
        "422": {
          "$ref": "#/components/responses/ValidationError"
        },
        "429": {
          "$ref": "#/components/responses/TooManyRequests"
        }
      }
    }
  },
  "/api/logout": {
    "post": {
      "tags": [
        "Auth"
      ],
      "summary": "Revoke the current token or end the cookie session",
      "security": [
        {
          "sanctum": []
        }
      ],
      "responses": {
        "200": {
          "$ref": "#/components/responses/Message"
        },
        "401": {
          "$ref": "#/components/responses/Unauthenticated"
        }
      }
    }
  },
  "/api/forgot-password": {
    "post": {
      "tags": [
        "Auth"
      ],
      "summary": "Send a password reset link",
      "description": "Always answers 200 so registered emails cannot be discovered. The link targets `FRONTEND_PASSWORD_RESET_URL?token=&email=`.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "email"
              ],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "$ref": "#/components/responses/Message"
        },
        "422": {
          "$ref": "#/components/responses/ValidationError"
        },
        "429": {
          "$ref": "#/components/responses/TooManyRequests"
        }
      }
    }
  },
  "/api/reset-password": {
    "post": {
      "tags": [
        "Auth"
      ],
      "summary": "Reset the password with an emailed token (revokes all tokens)",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "token",
                "email",
                "password",
                "password_confirmation"
              ],
              "properties": {
                "token": {
                  "type": "string"
                },
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "password": {
                  "type": "string"
                },
                "password_confirmation": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "$ref": "#/components/responses/Message"
        },
        "422": {
          "$ref": "#/components/responses/ValidationError"
        },
        "429": {
          "$ref": "#/components/responses/TooManyRequests"
        }
      }
    }
  },
  "/api/email/verify/{id}/{hash}": {
    "get": {
      "tags": [
        "Auth"
      ],
      "summary": "Verify an email address (signed URL from the verification email)",
      "description": "Browsers receive a redirect to `FRONTEND_EMAIL_VERIFIED_URL?status=verified`; clients sending an `Accept` header of `application/json` receive JSON.",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "hash",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "sha1 of the email address."
        },
        {
          "name": "expires",
          "in": "query",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "signature",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "$ref": "#/components/responses/Message"
        },
        "302": {
          "description": "Redirect to the frontend"
        },
        "403": {
          "description": "Invalid or expired link",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      }
    }
  },
  "/api/email/verification-notification": {
    "post": {
      "tags": [
        "Auth"
      ],
      "summary": "Resend the verification email",
      "security": [
        {
          "sanctum": []
        }
      ],
      "responses": {
        "200": {
          "$ref": "#/components/responses/Message"
        },
        "401": {
          "$ref": "#/components/responses/Unauthenticated"
        },
        "429": {
          "$ref": "#/components/responses/TooManyRequests"
        }
      }
    }
  }
}
