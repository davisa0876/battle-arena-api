APP_NAME="Battle Arena API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=battle_arena
DB_USERNAME=battle_arena
DB_PASSWORD=battle_arena_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Use local disk by default. Switch to s3 when the storage Compose profile is running.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@battlearena.local"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated browser origins for CORS (first entry is used to build email links)
FRONTEND_URL=http://localhost:3000
# Browser hosts that receive Sanctum session cookies (web SPA). Mobile uses bearer tokens.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Where verified-email redirects and password-reset links point (defaults derive from FRONTEND_URL)
FRONTEND_EMAIL_VERIFIED_URL=http://localhost:3000/verify-email
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Avatar storage: profiles_local (default, storage/app/profiles) or profiles (S3 / RustFS)
PROFILES_DISK=profiles_local

# Local S3 / RustFS (profile photos). Inside Compose: AWS_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=battlearena
AWS_SECRET_ACCESS_KEY=battlearena_minio
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=battle-arena-profiles
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/battle-arena-profiles
AWS_USE_PATH_STYLE_ENDPOINT=true

# Creature catalog provider (import only; never used on catalog page requests)
CREATURE_CATALOG_PROVIDER=pokeapi
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_TIMEOUT_SECONDS=8
POKEAPI_RETRY_TIMES=2
POKEAPI_RETRY_SLEEP_MS=250
POKEAPI_REQUEST_DELAY_MS=100
POKEAPI_CACHE_TTL_SECONDS=3600
