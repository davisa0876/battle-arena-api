APP_NAME="Battle Arena API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=battle_arena
DB_USERNAME=battle_arena
DB_PASSWORD=battle_arena_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@battlearena.local"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated browser origins for CORS
FRONTEND_URL=http://localhost:3000

# Local S3 / RustFS (profile photos). Inside Compose: AWS_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=battlearena
AWS_SECRET_ACCESS_KEY=battlearena_minio
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=battle-arena-profiles
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/battle-arena-profiles
AWS_USE_PATH_STYLE_ENDPOINT=true
